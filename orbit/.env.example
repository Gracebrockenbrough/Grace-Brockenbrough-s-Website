# Copy to .env.local for local development, or add these in Vercel -> Project -> Settings -> Environment Variables.

# Accounts (Supabase -> Project Settings -> API). Leave blank to run without accounts (data stays on each device).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: turns on AI answers in Ask Orbit and reading photos/screenshots (console.anthropic.com -> API keys).
# Server-side only; never shown to the browser.
ANTHROPIC_API_KEY=
